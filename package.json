{
  "name": "dsh-ecom-image",
  "version": "0.1.0",
  "description": "电商视觉创作技能：25 个场景模板（主图/场景/平铺/详情页/UGC 等）、Campaign Style Lock 一致性、转化驱动力诊断、GPT-Image-2 Prompt 铁律。可选通过 apiz CLI 直接出图。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ecommerce",
    "image",
    "prompt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/lib.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "prepack": "npm run build"
  }
}
