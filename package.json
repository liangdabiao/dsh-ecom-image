{
  "name": "dsh-ecom-image",
  "version": "0.3.0",
  "description": "电商图片生成工作台：即梦 dreamina-canvas（Seedream 5.5）+ apiz CLI 双通道生图、渠道/模型选择、25 个场景模板（带 30 张实测案例图与对应 Prompt）、生成历史画廊、Campaign Style Lock、一次一张验收闸门。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ecommerce",
    "image",
    "prompt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "selftest": "node scripts/selftest.mjs",
    "prepack": "npm run build",
    "sync-skill": "node scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}

